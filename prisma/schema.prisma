// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Owner id references Neon Auth's synced user table (neon_auth.users_sync),
// which Neon Auth manages outside of this schema — not modeled here directly.
model IsspDocument {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  agencyName    String
  agencyAcronym String
  startYear     Int
  endYear       Int
  planStatus    String   @default("draft")
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}
