# Copy to .env and fill in. .env is gitignored; this file is not.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL runs as the `db` service in docker-compose.yml, on the same host as
# the app. Use a long random password; nothing outside this box needs it.
POSTGRES_USER=issp
POSTGRES_DB=issp
POSTGRES_PASSWORD=change-me

# Read by `next dev` on the host, and by `prisma migrate deploy` / `prisma studio`.
# Inside the container compose overrides this with the db:5432 form, so the value
# here only matters for commands you run yourself.
DATABASE_URL="postgresql://issp:change-me@localhost:5433/issp?schema=public"

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# Neon Auth is a hosted service, separate from the database, and is still used.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
